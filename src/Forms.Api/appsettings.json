{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Forms": "Host=localhost;Port=5432;Database=forms;Username=forms;Password=forms"
  },
  "Forms": {
    "DraftRetention": "30.00:00:00",
    "DraftCleanupInterval": "01:00:00",
    "MaxDataBytes": 262144,
    "MaxRequestBodyBytes": 1048576,
    "ApplyMigrationsOnStartup": false
  }
}
